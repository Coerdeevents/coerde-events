{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Coerdeevents/coerde-events/main/docs/schema.json",
  "title": "Coerde Events",
  "description": "Schema der Datei data/events.json: öffentliche Veranstaltungen in Münster-Coerde.",
  "type": "object",
  "required": ["dataset", "license", "generated_at", "event_count", "events"],
  "properties": {
    "dataset": { "type": "string", "description": "Name des Datensatzes." },
    "description": { "type": "string", "description": "Kurzbeschreibung des Datensatzes." },
    "license": { "type": "string", "description": "Lizenz der Daten (CC-BY-4.0)." },
    "generated_at": { "type": "string", "format": "date-time", "description": "Zeitpunkt der Erzeugung (ISO 8601, UTC)." },
    "event_count": { "type": "integer", "minimum": 0, "description": "Anzahl der Einträge in events." },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "time": { "type": ["string", "null"], "pattern": "^\\d{2}:\\d{2}$" },
    "event": {
      "type": "object",
      "required": ["event_id", "title", "start_date", "end_date", "status", "source_name", "source_url"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1, "description": "Stabile, eindeutige ID des Termins." },
        "title": { "type": "string", "minLength": 1, "description": "Titel der Veranstaltung." },
        "start_date": { "$ref": "#/$defs/date", "description": "Startdatum (YYYY-MM-DD)." },
        "start_time": { "$ref": "#/$defs/time", "description": "Startuhrzeit (HH:MM), null falls unbekannt." },
        "end_date": { "$ref": "#/$defs/date", "description": "Enddatum (YYYY-MM-DD); bei eintägigen Terminen gleich dem Startdatum." },
        "end_time": { "$ref": "#/$defs/time", "description": "Enduhrzeit (HH:MM), null falls unbekannt." },
        "location_name": { "type": "string", "description": "Veranstaltungsort (Name)." },
        "address": { "type": "string", "description": "Adresse; leer, falls die Quelle keine nennt." },
        "city": { "type": "string", "description": "Ort, in der Regel Münster-Coerde." },
        "organizer": { "type": "string", "description": "Veranstalter." },
        "category": { "type": "string", "description": "Themen-/Kategorie-Zuordnung; kann leer sein." },
        "short_description": { "type": "string", "maxLength": 500, "description": "Kurzbeschreibung (max. 500 Zeichen)." },
        "status": { "type": "string", "description": "scheduled, cancelled, postponed oder unknown." },
        "source_name": { "type": "string", "description": "Name der Originalquelle." },
        "source_url": { "type": "string", "description": "URL der Originalquelle." },
        "source_id": { "type": "string", "description": "Technische Kennung der Quelle." },
        "confidence": { "type": "string", "pattern": "^(0(,\\d+)?|1(,0+)?)$", "description": "Verlässlichkeit des Eintrags zwischen 0 und 1, als Text mit Dezimalkomma." },
        "last_updated": { "type": "string", "format": "date-time", "description": "Zeitpunkt der letzten Aktualisierung (ISO 8601)." },
        "series_id": { "type": "string", "description": "Serien-ID; leer bei Einzelterminen." },
        "series_type": { "type": "string", "description": "weekly, biweekly, monthly, block, irregular oder leer." },
        "is_recurring": { "type": "string", "enum": ["ja", "nein"], "description": "ja bei regelmäßiger Wiederholung (weekly, biweekly, monthly)." },
        "series_label": { "type": "string", "description": "Lesbare Beschreibung der Serie, z. B. 'wöchentlich, freitags'." },
        "series_count": { "type": ["integer", "null"], "minimum": 1, "description": "Anzahl der Termine dieser Serie im aktuellen Datensatz; null bei Einzelterminen." }
      }
    }
  }
}
